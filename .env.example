# Copy to .env and fill in. `.env` is git-ignored; env vars already set in your shell win.
# The service loads this file itself (see verifier/config.py) - no shell export needed.

# ---- Provider ----------------------------------------------------------------
# anthropic = api.anthropic.com or any Anthropic-compatible endpoint
# openai    = any OpenAI-compatible /chat/completions endpoint (DeepSeek, vLLM, ...)
VERIFIER_PROVIDER=anthropic

# ---- Model -------------------------------------------------------------------
# Use the SAME model for minimal and optimized, otherwise the comparison is unfair.
VERIFIER_MODEL=

# ---- Credentials: option A, Anthropic (or Anthropic-compatible) --------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic   # DeepSeek's Anthropic-compatible endpoint

# ---- Credentials: option B, OpenAI-compatible (e.g. DeepSeek) ----------------
# VERIFIER_PROVIDER=openai
# VERIFIER_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=
# VERIFIER_MODEL=deepseek-chat
# Some endpoints need extra request fields. This client forces exactly one tool call, and DeepSeek's
# thinking models reject that with "Thinking mode does not support this tool_choice" unless thinking is
# off, so a DeepSeek run sets: {"thinking":{"type":"disabled"}}
# VERIFIER_EXTRA_BODY=

# ---- USD per 1M tokens, only used for the cost column of the report ----------
# deepseek-v4-pro peak cache-miss price, 2026-10-17; off-peak is half. Every input token is billed at
# the cache-miss rate, so the cost column is an upper bound. Update these for another model, then
# `uv run python -m eval.run --rescore <dir>` to recompute the column without calling the model.
PRICE_IN_PER_MTOK=1.32
PRICE_OUT_PER_MTOK=3.96

# ---- Optional knobs ----------------------------------------------------------
# VERIFIER_METHOD=optimized          # default method of POST /verify
# VERIFIER_PROMPT_VERSION=v3         # prompt set of the optimized verifier (v1-v4; v3 is the default)
# VERIFIER_TIMEOUT_S=60
# VERIFIER_MAX_RETRIES=3
# VERIFIER_ENV_FILE=                 # load a different env file than ./.env
# VERIFIER_API_KEY=                  # provider-agnostic key, checked before provider-specific ones

# ---- Annotation pipeline (annotation/README.md) ------------------------------
# v2.3 models only decompose claims or locate evidence; labels come from RAGTruth humans.
# Annotation models must be selected by the user; no review or translation in this round.
# DeepSeek-family models are forbidden for all annotation roles, including deepseek-flash.
# The drafting model for data/eval_hard.jsonl. Must differ from VERIFIER_MODEL (the model under
# test). No default on purpose -
# annotation.draft_claims stops and asks rather than guessing a model name.
# The drafting call uses the Anthropic client, so ANTHROPIC_API_KEY (and ANTHROPIC_BASE_URL, if the
# endpoint is not api.anthropic.com) must be set as well.
# ANNOTATION_MODEL=

# Retained legacy settings, inactive in v2.3: Chinese layer / advisory pre-review (annotation/zh.py,
# annotation/prereview.py). Must differ from VERIFIER_MODEL and from ANNOTATION_MODEL.
# REVIEW_MODEL=                     # required: user-selected non-DeepSeek model
# REVIEW_BASE_URL=                  # required: explicitly selected endpoint
# REVIEW_API_KEY=                   # required: user-selected key; no verifier-key fallback
